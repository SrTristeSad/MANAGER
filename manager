            if [[ -n "${7:-}" ]]; then exec "$MANAGER_HOME/modules/hive_health.sh" --configure "$4" "$5" "$6" "$7"; else exec "$MANAGER_HOME/modules/hive_health.sh" --configure "$4" "$5" "$6"; fi
            ;;
          disable) exec "$MANAGER_HOME/modules/hive_health.sh" --disable ;;
          send) exec "$MANAGER_HOME/modules/hive_health.sh" --send ;;
          controller)
            case "${4:-status}" in
              init) exec "$MANAGER_HOME/modules/hive_health.sh" --controller-init ;;
              status) exec "$MANAGER_HOME/modules/hive_health.sh" --controller-status ;;
              list) exec "$MANAGER_HOME/modules/hive_health.sh" --controller-list ;;
              show) [[ -n "${5:-}" ]] || { err "Uso: manager hive health controller show NODE_ID"; exit 64; }; exec "$MANAGER_HOME/modules/hive_health.sh" --controller-show "$5" ;;
