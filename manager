case "${1:-}" in
  --version|-v) echo "$VERSION"; exit 0 ;;
  --help|-h) usage; exit 0 ;;
esac

require_root

run_module() {
  local file="$1" rc
  shift || true
  if [[ -x "$MANAGER_HOME/modules/$file" ]]; then
    if "$MANAGER_HOME/modules/$file" "$@"; then
      return 0
    else
      rc=$?
      warn "O módulo $file terminou com erro (código $rc). O menu principal continuará ativo."
      pause
      return 0
    fi
  else
    err "Módulo ausente: $file"
    pause
  fi
}

run_provision_transaction() {
  local rc=0
  MANAGER_DEFER_POLICY_SIGNAL=1 "$MANAGER_HOME/modules/provision.sh" "$@" || rc=$?
  touch "$MANAGER_ETC/connection/.changed" 2>/dev/null || true
  return "$rc"
}

run_provision_menu() {
  local rc=0
  MANAGER_DEFER_POLICY_SIGNAL=1 "$MANAGER_HOME/modules/provision.sh" || rc=$?
  touch "$MANAGER_ETC/connection/.changed" 2>/dev/null || true
  if (( rc != 0 )); then
    warn "O módulo provision.sh terminou com erro (código $rc). O menu principal continuará ativo."
    pause
  fi
  return 0
}

self_update() {
  header
  say "${C_WHITE}ATUALIZAÇÃO DO MANAGER${C_RESET}\n"
  local remote tmp
  remote="$(curl -fsSL --connect-timeout 5 --max-time 10 "$MANAGER_RAW/VERSION" 2>/dev/null | tr -d '[:space:]' || true)"
  say "Instalada: ${C_GREEN}$VERSION${C_RESET}"
  say "Remota:    ${C_CYAN}${remote:-indisponível}${C_RESET}\n"
  [[ -n "$remote" ]] || { err "Não foi possível consultar a versão remota."; pause; return; }
  if [[ "$remote" == "$VERSION" ]]; then info "Você já está na versão publicada atualmente."; fi
  confirm "Baixar e instalar a versão publicada?" || return
  tmp="$(mktemp)"
  if ! curl -fL --proto '=https' --tlsv1.2 --connect-timeout 10 --max-time 60 "$MANAGER_RAW/install.sh" -o "$tmp"; then
    rm -f "$tmp"; err "Falha ao baixar o instalador."; pause; return
  fi
  chmod 0700 "$tmp"
  if ! bash -n "$tmp"; then rm -f "$tmp"; err "O instalador baixado não passou na validação de sintaxe."; pause; return; fi
  info "Instalador baixado e validado com bash -n."
  if MANAGER_REPO_RAW="$MANAGER_RAW" bash "$tmp" --update; then
    ok "MANAGER atualizado"
    VERSION="$(tr -d '[:space:]' < "$MANAGER_HOME/VERSION")"
  else
    err "A atualização falhou. Use o rollback se necessário."
  fi
  rm -f "$tmp"
  pause
}

menu_summary() {
  local load disk mem
  load="$(awk '{print $1}' /proc/loadavg 2>/dev/null || echo '-')"
  disk="$(df -P / 2>/dev/null | awk 'NR==2 {print $5}' || echo '-')"
  mem="$(free 2>/dev/null | awk '/Mem:/ {if ($2>0) printf "%.0f%%", ($3/$2)*100; else print "-"}' || echo '-')"
  printf ' %-18s %s\n' "Versão:" "$VERSION"
  printf ' %-18s %s\n' "Servidor:" "$(hostname)"
  printf ' %-18s %s\n' "Carga:" "$load"
  printf ' %-18s %s\n' "RAM / Disco:" "$mem / $disk"
  [[ -f /var/run/reboot-required ]] && printf ' %-18s %b\n' "Reboot:" "${C_YELLOW}pendente${C_RESET}"
  say ""
}

case "${1:-}" in
  --health) exec "$MANAGER_HOME/modules/health.sh" --check ;;
  --status) exec "$MANAGER_HOME/modules/system.sh" services ;;
  --expired) exec "$MANAGER_HOME/modules/ssh_users.sh" --list-expired ;;
  --ssh-sessions) exec "$MANAGER_HOME/modules/ssh_monitor.sh" --summary ;;
  --proxy-status) exec "$MANAGER_HOME/modules/proxies.sh" --status ;;
  --proxy-hosts) exec "$MANAGER_HOME/modules/proxy_hosts.sh" --list ;;
  --identities) exec "$MANAGER_HOME/modules/connection_engine.sh" --list ;;
  --identity) [[ -n "${2:-}" ]] || { err "Informe o ID da identidade"; exit 64; }; exec "$MANAGER_HOME/modules/connection_engine.sh" --show "$2" ;;
  --products) exec "$MANAGER_HOME/modules/products.sh" --list ;;
  --product) [[ -n "${2:-}" ]] || { err "Informe o ID do produto"; exit 64; }; exec "$MANAGER_HOME/modules/products.sh" --show "$2" ;;
  --product-assignment) [[ -n "${2:-}" ]] || { err "Informe o ID da identidade"; exit 64; }; exec "$MANAGER_HOME/modules/products.sh" --assignment "$2" ;;
  --reseller-usage) [[ -n "${2:-}" ]] || { err "Informe o ID do revendedor"; exit 64; }; exec "$MANAGER_HOME/modules/resellers.sh" --usage-detail "$2" ;;
  --reseller-product-quota)
    [[ -n "${2:-}" && -n "${3:-}" ]] || { err "Uso: manager --reseller-product-quota OWNER PRODUCT"; exit 64; }
    exec "$MANAGER_HOME/modules/reseller_product_quotas.sh" --show "$2" "$3"
    ;;
  --provision)
    [[ -n "${2:-}" && -n "${3:-}" ]] || { err "Uso: manager --provision ID PLAN [OWNER] [PROTOCOLS]"; exit 64; }
    run_provision_transaction --create "$2" "$3" "${4:-}" "${5:-}"; exit $?
    ;;
  --revoke-identity) [[ -n "${2:-}" ]] || { err "Informe o ID da identidade"; exit 64; }; run_provision_transaction --revoke "$2"; exit $? ;;
  --identity-sessions) exec "$MANAGER_HOME/modules/policy_engine.sh" --sessions "${2:-}" ;;
  --leases) exec "$MANAGER_HOME/modules/session_engine.sh" --list "${2:-}" ;;
  --usage) if [[ -n "${2:-}" ]]; then exec "$MANAGER_HOME/modules/identity_usage.sh" --show "$2"; else exec "$MANAGER_HOME/modules/identity_usage.sh" --list; fi ;;
  --ipv6-status) exec "$MANAGER_HOME/modules/ipv6_guard.sh" --status ;;
  --node) exec "$MANAGER_HOME/modules/node_metadata.sh" --show ;;
  --node-context) exec "$MANAGER_HOME/modules/node_metadata.sh" --context ;;
  --node-set) [[ -n "${2:-}" ]] || { err "Uso: manager --node-set FIELD VALUE"; exit 64; }; exec "$MANAGER_HOME/modules/node_metadata.sh" --set "$2" "${3:-}" ;;
  hive)
    case "${2:-status}" in
      status) exec "$MANAGER_HOME/modules/hive_identity.sh" --status ;;
      request) [[ -n "${3:-}" ]] || { err "Uso: manager hive request /CAMINHO/request.json"; exit 64; }; exec "$MANAGER_HOME/modules/hive_identity.sh" --request "$3" ;;
      accept) [[ -n "${3:-}" && -n "${4:-}" ]] || { err "Uso: manager hive accept BUNDLE CONTROLLER_FP"; exit 64; }; exec "$MANAGER_HOME/modules/hive_identity.sh" --accept "$3" "$4" ;;
      key)
        case "${3:-status}" in
          status) exec "$MANAGER_HOME/modules/hive_key_rotation.sh" --status ;;
          node)
            case "${4:-status}" in
              prepare) [[ -n "${5:-}" ]] || { err "Uso: manager hive key node prepare OUT"; exit 64; }; exec "$MANAGER_HOME/modules/hive_key_rotation.sh" --node-prepare "$5" ;;
              commit) [[ -n "${5:-}" ]] || { err "Uso: manager hive key node commit BUNDLE"; exit 64; }; exec "$MANAGER_HOME/modules/hive_key_rotation.sh" --node-commit "$5" ;;
              accept-controller) [[ -n "${5:-}" ]] || { err "Uso: manager hive key node accept-controller TRANSITION"; exit 64; }; exec "$MANAGER_HOME/modules/hive_key_rotation.sh" --node-accept-controller "$5" ;;
              *) err "Uso: manager hive key node {prepare|commit|accept-controller} ..."; exit 64 ;;
            esac
            ;;
          controller)
            case "${4:-status}" in
              accept-node) [[ -n "${5:-}" && -n "${6:-}" ]] || { err "Uso: manager hive key controller accept-node REQUEST OUT"; exit 64; }; exec "$MANAGER_HOME/modules/hive_key_rotation.sh" --controller-accept-node "$5" "$6" ;;
              prepare) [[ -n "${5:-}" ]] || { err "Uso: manager hive key controller prepare OUT"; exit 64; }; exec "$MANAGER_HOME/modules/hive_key_rotation.sh" --controller-prepare "$5" ;;
              commit) [[ -n "${5:-}" ]] || { err "Uso: manager hive key controller commit TRANSITION"; exit 64; }; exec "$MANAGER_HOME/modules/hive_key_rotation.sh" --controller-commit "$5" ;;
              *) err "Uso: manager hive key controller {accept-node|prepare|commit} ..."; exit 64 ;;
            esac
            ;;
          *) err "Uso: manager hive key {status|node ...|controller ...}"; exit 64 ;;
        esac
        ;;
      network)
        case "${3:-status}" in
          status) exec "$MANAGER_HOME/modules/hive_network.sh" --status ;;
          init) exec "$MANAGER_HOME/modules/hive_network.sh" --init ;;
          request)
            [[ -n "${4:-}" && -n "${5:-}" ]] || { err "Uso: manager hive network request ENDPOINT OUT [PORT]"; exit 64; }
            if [[ -n "${6:-}" ]]; then exec "$MANAGER_HOME/modules/hive_network.sh" --request "$4" "$5" "$6"; else exec "$MANAGER_HOME/modules/hive_network.sh" --request "$4" "$5"; fi
            ;;
          accept) [[ -n "${4:-}" ]] || { err "Uso: manager hive network accept BUNDLE"; exit 64; }; exec "$MANAGER_HOME/modules/hive_network.sh" --accept "$4" ;;
          up|reconcile) exec "$MANAGER_HOME/modules/hive_network.sh" --reconcile ;;
          down) exec "$MANAGER_HOME/modules/hive_network.sh" --down ;;
          rotate)
            case "${4:-status}" in
              status) exec "$MANAGER_HOME/modules/hive_wg_rotation.sh" --status ;;
              prepare) [[ -n "${5:-}" ]] || { err "Uso: manager hive network rotate prepare OUT"; exit 64; }; exec "$MANAGER_HOME/modules/hive_wg_rotation.sh" --node-prepare "$5" ;;
              commit) [[ -n "${5:-}" && -n "${6:-}" ]] || { err "Uso: manager hive network rotate commit AUTH BUNDLE"; exit 64; }; exec "$MANAGER_HOME/modules/hive_wg_rotation.sh" --node-commit "$5" "$6" ;;
              *) err "Uso: manager hive network rotate {status|prepare OUT|commit AUTH BUNDLE}"; exit 64 ;;
            esac
            ;;
          controller)
            case "${4:-status}" in
              init) exec "$MANAGER_HOME/modules/hive_network.sh" --controller-init ;;
              status) exec "$MANAGER_HOME/modules/hive_network.sh" --controller-status ;;
              list) exec "$MANAGER_HOME/modules/hive_network.sh" --controller-list ;;
              show) [[ -n "${5:-}" ]] || { err "Uso: manager hive network controller show NODE_ID"; exit 64; }; exec "$MANAGER_HOME/modules/hive_network.sh" --controller-show "$5" ;;
              approve) [[ -n "${5:-}" ]] || { err "Uso: manager hive network controller approve REQUEST"; exit 64; }; exec "$MANAGER_HOME/modules/hive_network.sh" --controller-approve "$5" ;;
              enable) [[ -n "${5:-}" ]] || { err "Uso: manager hive network controller enable NODE_ID"; exit 64; }; exec "$MANAGER_HOME/modules/hive_network.sh" --controller-enable "$5" ;;
              disable) [[ -n "${5:-}" ]] || { err "Uso: manager hive network controller disable NODE_ID"; exit 64; }; exec "$MANAGER_HOME/modules/hive_network.sh" --controller-disable "$5" ;;
              bundle) [[ -n "${5:-}" && -n "${6:-}" ]] || { err "Uso: manager hive network controller bundle NODE_ID OUT"; exit 64; }; exec "$MANAGER_HOME/modules/hive_network.sh" --controller-bundle "$5" "$6" ;;
              bundle-all) [[ -n "${5:-}" ]] || { err "Uso: manager hive network controller bundle-all DIR"; exit 64; }; exec "$MANAGER_HOME/modules/hive_network.sh" --controller-bundle-all "$5" ;;
              rotate)
                case "${5:-status}" in
                  status) exec "$MANAGER_HOME/modules/hive_wg_rotation.sh" --controller-status ;;
                  stage) [[ -n "${6:-}" && -n "${7:-}" ]] || { err "Uso: manager hive network controller rotate stage REQUEST OUT"; exit 64; }; exec "$MANAGER_HOME/modules/hive_wg_rotation.sh" --controller-stage "$6" "$7" ;;
                  activate) [[ -n "${6:-}" && -n "${7:-}" ]] || { err "Uso: manager hive network controller rotate activate ROTATION_ID OUT_DIR"; exit 64; }; exec "$MANAGER_HOME/modules/hive_wg_rotation.sh" --controller-activate "$6" "$7" ;;
                  *) err "Uso: manager hive network controller rotate {status|stage REQUEST OUT|activate ROTATION_ID OUT_DIR}"; exit 64 ;;
                esac
                ;;
              *) err "Ação de rede do controlador inválida: ${4:-}"; exit 64 ;;
            esac
            ;;
          *) err "Uso: manager hive network {status|init|request|accept|up|down|reconcile|rotate ...|controller ...}"; exit 64 ;;
        esac
        ;;
      health)
        case "${3:-status}" in
          status) exec "$MANAGER_HOME/modules/hive_health.sh" --status ;;
          configure)
