#!/usr/bin/env bash
set -Eeuo pipefail

MANAGER_HOME="${MANAGER_HOME:-/opt/manager}"
MANAGER_ETC="${MANAGER_ETC:-/etc/manager}"

if [[ -f "$MANAGER_HOME/lib/common.sh" ]]; then
  # shellcheck source=/dev/null
  source "$MANAGER_HOME/lib/common.sh"
else
  echo "MANAGER não está instalado corretamente em $MANAGER_HOME" >&2
  exit 1
fi

require_root

VERSION="unknown"
[[ -f "$MANAGER_HOME/VERSION" ]] && VERSION="$(tr -d '[:space:]' < "$MANAGER_HOME/VERSION")"

run_module() {
  local file="$1"
  shift || true
  if [[ -x "$MANAGER_HOME/modules/$file" ]]; then
    if ! "$MANAGER_HOME/modules/$file" "$@"; then
      warn "O módulo $file terminou com erro. O menu principal continuará ativo."
      pause
    fi
  else
    err "Módulo ausente: $file"
    pause
  fi
}

self_update() {
  header
  say "${C_WHITE}ATUALIZAÇÃO DO MANAGER${C_RESET}\n"
  local remote
  remote="$(curl -fsSL --max-time 5 https://raw.githubusercontent.com/SrTristeSad/MANAGER/main/VERSION 2>/dev/null | tr -d '[:space:]' || true)"
  say "Instalada: ${C_GREEN}$VERSION${C_RESET}"
  say "Remota:    ${C_CYAN}${remote:-indisponível}${C_RESET}\n"
  if confirm "Baixar e reinstalar a versão atual do repositório?"; then
    if curl -fsSL https://raw.githubusercontent.com/SrTristeSad/MANAGER/main/install.sh | bash -s -- --update; then
      ok "MANAGER atualizado"
      VERSION="$(tr -d '[:space:]' < "$MANAGER_HOME/VERSION")"
    else
      err "A atualização falhou."
    fi
    pause
  fi
}

menu_summary() {
  local load disk
  load="$(awk '{print $1}' /proc/loadavg 2>/dev/null || echo '-')"
  disk="$(df -P / 2>/dev/null | awk 'NR==2 {print $5}' || echo '-')"
  printf ' %-18s %s\n' "Versão:" "$VERSION"
  printf ' %-18s %s\n' "Servidor:" "$(hostname)"
  printf ' %-18s %s\n' "Carga / Disco:" "$load / $disk"
  say ""
}

while true; do
  header
  menu_summary
  say " ${C_WHITE}SERVIDOR${C_RESET}"
  say "  ${C_CYAN}1${C_RESET}) Informações do sistema"
  say "  ${C_CYAN}2${C_RESET}) Usuários SSH"
  say "  ${C_CYAN}3${C_RESET}) WireGuard VPN"
  say "  ${C_CYAN}4${C_RESET}) Bloqueio de anúncios DNS"
  say ""
  say " ${C_WHITE}SEGURANÇA${C_RESET}"
  say "  ${C_CYAN}5${C_RESET}) Segurança / hardening SSH"
  say "  ${C_CYAN}6${C_RESET}) Firewall"
  say "  ${C_CYAN}7${C_RESET}) Fail2ban"
  say ""
  say " ${C_WHITE}MONITORAMENTO E MANUTENÇÃO${C_RESET}"
  say "  ${C_CYAN}8${C_RESET}) Tráfego e conexões"
  say "  ${C_CYAN}9${C_RESET}) Diagnóstico"
  say " ${C_CYAN}10${C_RESET}) Backup e rollback"
  say " ${C_CYAN}11${C_RESET}) Desempenho / BBR"
  say " ${C_CYAN}12${C_RESET}) Logs"
  say " ${C_CYAN}20${C_RESET}) Status dos serviços"
  say ""
  say " ${C_CYAN}90${C_RESET}) Atualizar MANAGER"
  say "  ${C_CYAN}0${C_RESET}) Sair"
  say ""
  read -r -p "Opção: " opt

  case "$opt" in
    1) run_module system.sh info ;;
    2) run_module ssh_users.sh ;;
    3) run_module wireguard.sh ;;
    4) run_module adblock.sh ;;
    5) run_module security.sh ;;
    6) run_module firewall.sh ;;
    7) run_module fail2ban.sh ;;
    8) run_module traffic.sh ;;
    9) run_module diagnostics.sh ;;
    10) run_module backup.sh ;;
    11) run_module performance.sh ;;
    12) run_module logs.sh ;;
    20) run_module system.sh services ;;
    90) self_update ;;
    0) clear 2>/dev/null || true; exit 0 ;;
    *) warn "Opção inválida"; sleep 1 ;;
  esac
done
