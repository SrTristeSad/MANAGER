#!/usr/bin/env bash
set -Eeuo pipefail

MANAGER_HOME="${MANAGER_HOME:-/opt/manager}"
MANAGER_ETC="${MANAGER_ETC:-/etc/manager}"
MANAGER_RAW="${MANAGER_REPO_RAW:-https://raw.githubusercontent.com/SrTristeSad/MANAGER/main}"

if [[ -f "$MANAGER_HOME/lib/common.sh" ]]; then
  # shellcheck source=/dev/null
  source "$MANAGER_HOME/lib/common.sh"
else
  echo "MANAGER não está instalado corretamente em $MANAGER_HOME" >&2
  exit 1
fi

VERSION="unknown"
[[ -f "$MANAGER_HOME/VERSION" ]] && VERSION="$(tr -d '[:space:]' < "$MANAGER_HOME/VERSION")"

usage() {
  cat <<EOF
MANAGER $VERSION

Uso:
  manager                         abre o menu interativo
  manager --health                executa health check (0=OK, 1=avisos, 2=crítico)
  manager --status                mostra status resumido dos serviços
  manager --expired               lista contas SSH expiradas
  manager --ssh-sessions          mostra sessões SSH atuais
  manager --proxy-status          mostra proxies/túneis gerenciados
  manager --proxy-hosts           lista hosts cadastrados para o Squid
  manager --identities            lista identidades do Connection Engine
  manager --identity ID           mostra uma identidade do Connection Engine
  manager --products              lista produtos/planos
  manager --product ID            mostra um produto/plano
  manager --product-assignment ID mostra plano, limites e franquia de uma identidade
  manager --reseller-usage OWNER  mostra uso/cota total do revendedor por identidade
  manager --reseller-product-quota OWNER PRODUCT
                                  mostra uso/cota de um produto para o revendedor
  manager --provision ID PLAN [OWNER] [PROTOCOLS]
                                  cria identidade + plano + acessos em uma transação
  manager --revoke-identity ID    revoga acessos e preserva a identidade desativada
  manager --identity-sessions [ID] mostra sessões observadas por identidade
  manager --leases [ID]           mostra leases locais ativas
  manager --usage [ID]            mostra tráfego/atividade consolidada por identidade
  manager --ipv6-status           mostra estado dual-stack, egress e IPv6 Guard
  manager --diagnostics           abre o diagnóstico
  manager --version               mostra a versão
  manager --help                  mostra esta ajuda
EOF
}

case "${1:-}" in
  --version|-v)
    echo "$VERSION"
    exit 0
    ;;
  --help|-h)
    usage
    exit 0
    ;;
esac

require_root

run_module() {
  local file="$1" rc
  shift || true
  if [[ -x "$MANAGER_HOME/modules/$file" ]]; then
    if "$MANAGER_HOME/modules/$file" "$@"; then
      return 0
    else
      rc=$?
      warn "O módulo $file terminou com erro (código $rc). O menu principal continuará ativo."
      pause
      return 0
    fi
  else
    err "Módulo ausente: $file"
    pause
  fi
}

run_provision_transaction() {
  local rc=0
  MANAGER_DEFER_POLICY_SIGNAL=1 "$MANAGER_HOME/modules/provision.sh" "$@" || rc=$?
  touch "$MANAGER_ETC/connection/.changed" 2>/dev/null || true
  return "$rc"
}

run_provision_menu() {
  local rc=0
  MANAGER_DEFER_POLICY_SIGNAL=1 "$MANAGER_HOME/modules/provision.sh" || rc=$?
  touch "$MANAGER_ETC/connection/.changed" 2>/dev/null || true
  if (( rc != 0 )); then
    warn "O módulo provision.sh terminou com erro (código $rc). O menu principal continuará ativo."
    pause
  fi
  return 0
}

self_update() {
  header
  say "${C_WHITE}ATUALIZAÇÃO DO MANAGER${C_RESET}\n"
  local remote tmp
  remote="$(curl -fsSL --connect-timeout 5 --max-time 10 "$MANAGER_RAW/VERSION" 2>/dev/null | tr -d '[:space:]' || true)"
  say "Instalada: ${C_GREEN}$VERSION${C_RESET}"
  say "Remota:    ${C_CYAN}${remote:-indisponível}${C_RESET}\n"

  [[ -n "$remote" ]] || { err "Não foi possível consultar a versão remota."; pause; return; }
  if [[ "$remote" == "$VERSION" ]]; then info "Você já está na versão publicada atualmente."; fi
  confirm "Baixar e instalar a versão publicada?" || return

  tmp="$(mktemp)"
  if ! curl -fL --proto '=https' --tlsv1.2 --connect-timeout 10 --max-time 60 "$MANAGER_RAW/install.sh" -o "$tmp"; then
    rm -f "$tmp"
    err "Falha ao baixar o instalador."
    pause
    return
  fi
  chmod 0700 "$tmp"
  if ! bash -n "$tmp"; then
    rm -f "$tmp"
    err "O instalador baixado não passou na validação de sintaxe."
    pause
    return
  fi

  info "Instalador baixado e validado com bash -n."
  if MANAGER_REPO_RAW="$MANAGER_RAW" bash "$tmp" --update; then
    ok "MANAGER atualizado"
    VERSION="$(tr -d '[:space:]' < "$MANAGER_HOME/VERSION")"
  else
    err "A atualização falhou. Use o rollback se necessário."
  fi
  rm -f "$tmp"
  pause
}

menu_summary() {
  local load disk mem
  load="$(awk '{print $1}' /proc/loadavg 2>/dev/null || echo '-')"
  disk="$(df -P / 2>/dev/null | awk 'NR==2 {print $5}' || echo '-')"
  mem="$(free 2>/dev/null | awk '/Mem:/ {if ($2>0) printf "%.0f%%", ($3/$2)*100; else print "-"}' || echo '-')"
  printf ' %-18s %s\n' "Versão:" "$VERSION"
  printf ' %-18s %s\n' "Servidor:" "$(hostname)"
  printf ' %-18s %s\n' "Carga:" "$load"
  printf ' %-18s %s\n' "RAM / Disco:" "$mem / $disk"
  [[ -f /var/run/reboot-required ]] && printf ' %-18s %b\n' "Reboot:" "${C_YELLOW}pendente${C_RESET}"
  say ""
}

case "${1:-}" in
  --health) exec "$MANAGER_HOME/modules/health.sh" --check ;;
  --status) exec "$MANAGER_HOME/modules/system.sh" services ;;
  --expired) exec "$MANAGER_HOME/modules/ssh_users.sh" --list-expired ;;
  --ssh-sessions) exec "$MANAGER_HOME/modules/ssh_monitor.sh" --summary ;;
  --proxy-status) exec "$MANAGER_HOME/modules/proxies.sh" --status ;;
  --proxy-hosts) exec "$MANAGER_HOME/modules/proxy_hosts.sh" --list ;;
  --identities) exec "$MANAGER_HOME/modules/connection_engine.sh" --list ;;
  --identity)
    [[ -n "${2:-}" ]] || { err "Informe o ID da identidade"; exit 64; }
    exec "$MANAGER_HOME/modules/connection_engine.sh" --show "$2"
    ;;
  --products) exec "$MANAGER_HOME/modules/products.sh" --list ;;
  --product)
    [[ -n "${2:-}" ]] || { err "Informe o ID do produto"; exit 64; }
    exec "$MANAGER_HOME/modules/products.sh" --show "$2"
    ;;
  --product-assignment)
    [[ -n "${2:-}" ]] || { err "Informe o ID da identidade"; exit 64; }
    exec "$MANAGER_HOME/modules/products.sh" --assignment "$2"
    ;;
  --reseller-usage)
    [[ -n "${2:-}" ]] || { err "Informe o ID do revendedor"; exit 64; }
    exec "$MANAGER_HOME/modules/resellers.sh" --usage-detail "$2"
    ;;
  --reseller-product-quota)
    [[ -n "${2:-}" && -n "${3:-}" ]] || { err "Uso: manager --reseller-product-quota OWNER PRODUCT"; exit 64; }
    exec "$MANAGER_HOME/modules/reseller_product_quotas.sh" --show "$2" "$3"
    ;;
  --provision)
    [[ -n "${2:-}" && -n "${3:-}" ]] || { err "Uso: manager --provision ID PLAN [OWNER] [PROTOCOLS]"; exit 64; }
    run_provision_transaction --create "$2" "$3" "${4:-}" "${5:-}"
    exit $?
    ;;
  --revoke-identity)
    [[ -n "${2:-}" ]] || { err "Informe o ID da identidade"; exit 64; }
    run_provision_transaction --revoke "$2"
    exit $?
    ;;
  --identity-sessions) exec "$MANAGER_HOME/modules/policy_engine.sh" --sessions "${2:-}" ;;
  --leases) exec "$MANAGER_HOME/modules/session_engine.sh" --list "${2:-}" ;;
  --usage)
    if [[ -n "${2:-}" ]]; then
      exec "$MANAGER_HOME/modules/identity_usage.sh" --show "$2"
    else
      exec "$MANAGER_HOME/modules/identity_usage.sh" --list
    fi
    ;;
  --ipv6-status) exec "$MANAGER_HOME/modules/ipv6_guard.sh" --status ;;
  --diagnostics) exec "$MANAGER_HOME/modules/diagnostics.sh" ;;
  "") ;;
  *)
    err "Opção desconhecida: $1"
    usage
    exit 64
    ;;
esac

while true; do
  header
  menu_summary
  say " ${C_WHITE}SERVIDOR E VPN${C_RESET}"
  say "  ${C_CYAN}1${C_RESET}) Informações do sistema"
  say "  ${C_CYAN}2${C_RESET}) Usuários SSH"
  say "  ${C_CYAN}3${C_RESET}) WireGuard VPN"
  say "  ${C_CYAN}4${C_RESET}) OpenVPN"
  say "  ${C_CYAN}5${C_RESET}) Bloqueio de anúncios DNS"
  say " ${C_CYAN}19${C_RESET}) Banner SSH"
  say " ${C_CYAN}25${C_RESET}) Hosts do proxy"
  say " ${C_CYAN}26${C_RESET}) Proxies e túneis"
  say " ${C_CYAN}35${C_RESET}) Estado IPv6 / dual-stack"
  say ""
  say " ${C_WHITE}SEGURANÇA${C_RESET}"
  say "  ${C_CYAN}6${C_RESET}) Segurança / hardening SSH"
  say "  ${C_CYAN}7${C_RESET}) Firewall"
  say "  ${C_CYAN}8${C_RESET}) Fail2ban"
  say "  ${C_CYAN}9${C_RESET}) TLS / Let's Encrypt"
  say " ${C_CYAN}18${C_RESET}) Chaves públicas SSH"
  say ""
  say " ${C_WHITE}CONTAS E REVENDA${C_RESET}"
  say " ${C_CYAN}22${C_RESET}) Monitor de sessões SSH"
  say " ${C_CYAN}23${C_RESET}) Backup / migração de usuários"
  say " ${C_CYAN}24${C_RESET}) Revendedores, subrevendedores e cotas"
  say " ${C_CYAN}27${C_RESET}) Criar conta vinculada a revendedor"
  say " ${C_CYAN}28${C_RESET}) Connection Engine / identidades"
  say " ${C_CYAN}29${C_RESET}) Sessões observadas / reconciliar políticas"
  say " ${C_CYAN}30${C_RESET}) Session / Lease Engine"
  say " ${C_CYAN}32${C_RESET}) Produtos, planos, ACL e franquias"
  say " ${C_CYAN}33${C_RESET}) Provisionamento unificado / revogação"
  say " ${C_CYAN}34${C_RESET}) Cotas de produto por revendedor"
  say ""
  say " ${C_WHITE}MONITORAMENTO E MANUTENÇÃO${C_RESET}"
  say " ${C_CYAN}10${C_RESET}) Tráfego e conexões"
  say " ${C_CYAN}11${C_RESET}) Diagnóstico"
  say " ${C_CYAN}12${C_RESET}) Backup e rollback"
  say " ${C_CYAN}13${C_RESET}) Desempenho / BBR"
  say " ${C_CYAN}14${C_RESET}) Logs"
  say " ${C_CYAN}15${C_RESET}) Assistente / perfis"
  say " ${C_CYAN}16${C_RESET}) Saúde do servidor"
  say " ${C_CYAN}17${C_RESET}) Manutenção do sistema"
  say " ${C_CYAN}20${C_RESET}) Serviços"
  say " ${C_CYAN}21${C_RESET}) Speedtest / latência"
  say " ${C_CYAN}31${C_RESET}) Uso e atividade por identidade"
  say ""
  say " ${C_CYAN}90${C_RESET}) Atualizar MANAGER"
  say "  ${C_CYAN}0${C_RESET}) Sair"
  say ""
  read -r -p "Opção: " opt

  case "$opt" in
    1) run_module system.sh info ;;
    2) run_module ssh_users.sh ;;
    3) run_module wireguard.sh ;;
    4) run_module openvpn.sh ;;
    5) run_module adblock.sh ;;
    6) run_module security.sh ;;
    7) run_module firewall.sh ;;
    8) run_module fail2ban.sh ;;
    9) run_module tls.sh ;;
    10) run_module traffic.sh ;;
    11) run_module diagnostics.sh ;;
    12) run_module backup.sh ;;
    13) run_module performance.sh ;;
    14) run_module logs.sh ;;
    15) run_module profiles.sh ;;
    16) run_module health.sh ;;
    17) run_module maintenance.sh ;;
    18) run_module ssh_keys.sh ;;
    19) run_module banner.sh ;;
    20) run_module system.sh service-menu ;;
    21) run_module speedtest.sh ;;
    22) run_module ssh_monitor.sh ;;
    23) run_module user_transfer.sh ;;
    24) run_module resellers.sh ;;
    25) run_module proxy_hosts.sh ;;
    26) run_module proxies.sh ;;
    27) run_module reseller_accounts.sh ;;
    28) run_module connection_engine.sh ;;
    29)
      header
      say "${C_WHITE}SESSÕES OBSERVADAS / POLÍTICAS${C_RESET}\n"
      "$MANAGER_HOME/modules/policy_engine.sh" --sessions || true
      say ""
      if confirm "Reconciliar políticas agora?"; then
        "$MANAGER_HOME/modules/policy_engine.sh" --reconcile || true
        ok "Reconciliação solicitada"
      fi
      pause
      ;;
    30) run_module session_engine.sh ;;
    31) run_module identity_usage.sh ;;
    32) run_module products.sh ;;
    33) run_provision_menu ;;
    34) run_module reseller_product_quotas.sh ;;
    35)
      header
      say "${C_WHITE}ESTADO IPV6 / DUAL-STACK${C_RESET}\n"
      "$MANAGER_HOME/modules/ipv6_guard.sh" --status || true
      say ""
      "$MANAGER_HOME/modules/wireguard.sh" --network-state 2>/dev/null || true
      "$MANAGER_HOME/modules/openvpn.sh" --network-state 2>/dev/null || true
      pause
      ;;
    90) self_update ;;
    0) clear 2>/dev/null || true; exit 0 ;;
    *) warn "Opção inválida"; sleep 1 ;;
  esac
done
