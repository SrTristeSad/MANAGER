      say " 2) Credenciais Ed25519"
      say " 3) Transporte remoto TLS 1.3"
      say " 0) Voltar"
      say ""
      read -r -p "Opção: " automation_opt
      case "$automation_opt" in
        1) run_module automation_principals.sh ;;
        2) run_module automation_credentials.sh ;;
        3)
          header
          "$MANAGER_HOME/modules/automation_v2.sh" --remote-status || true
          say ""
          say "Use o CLI para alterar:"
          say " manager automation v2 remote enable BIND_IP [PORT]"
          say " manager automation v2 remote disable"
          say " manager automation v2 remote rotate-certificate"
          pause
          ;;
        0) ;;
        *) warn "Opção inválida"; sleep 1 ;;
      esac
      ;;
    39)
      header
      say "${C_WHITE}COLMEIA — IDENTIDADE / ENROLLMENT${C_RESET}\n"
      "$MANAGER_HOME/modules/hive_identity.sh" --status || true
      say ""
      "$MANAGER_HOME/modules/hive_identity.sh" --controller-status || true
      say ""
      say "Fluxo de enrollment via CLI:"
      say " manager hive request /root/node-request.json"
      say " manager hive controller approve REQUEST /root/node-bundle.json"
      say " manager hive accept BUNDLE SHA256:<fingerprint-controlador>"
      pause
      ;;
    40)
      header
      say "${C_WHITE}COLMEIA — REDE PRIVADA WIREGUARD${C_RESET}\n"
      "$MANAGER_HOME/modules/hive_network.sh" --status || true
      say ""
      "$MANAGER_HOME/modules/hive_network.sh" --controller-status 2>/dev/null || true
      say ""
      say "Fluxo via CLI:"
      say " manager hive network request ENDPOINT /root/node.network.json [PORT]"
      say " manager hive network controller approve REQUEST"
      say " manager hive network controller bundle-all /root/hive-bundles"
      say " manager hive network accept BUNDLE"
      pause
      ;;
    41)
      header
      say "${C_WHITE}COLMEIA — HEARTBEAT / SAÚDE${C_RESET}\n"
      "$MANAGER_HOME/modules/hive_health.sh" --status || true
      say ""
      "$MANAGER_HOME/modules/hive_health.sh" --controller-status 2>/dev/null || true
      say ""
      say "Fluxo via CLI:"
      say " manager hive health controller enable BIND_IP [PORT]"
      say " manager hive health configure HOST PORT SHA256:<tls-fingerprint> [INTERVAL]"
      say " manager hive health send"
      say " manager hive health controller list"
      pause
      ;;
    42)
      header
      say "${C_WHITE}COLMEIA — LEASES GLOBAIS${C_RESET}\n"
      "$MANAGER_HOME/modules/hive_leases.sh" --status || true
      say ""
      "$MANAGER_HOME/modules/hive_leases.sh" --controller-status 2>/dev/null || true
      say ""
      say "Fluxo via CLI:"
      say " manager hive lease controller enable BIND_IP [PORT]"
      say " manager hive lease limit set maria 1"
      say " manager hive lease node configure HOST PORT SHA256:<tls-fingerprint>"
      say " manager hive lease controller list [ID]"
      pause
      ;;
    90) self_update ;;
    0) clear 2>/dev/null || true; exit 0 ;;
    *) warn "Opção inválida"; sleep 1 ;;
  esac
done
